# Supabase > Project Settings > Database > Connection string > Session pooler
# Never commit the real .env.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# FastAPI job runner: shared secret NestJS sends as the x-ml-key header
ML_API_KEY=<long random string>

# Optional, local development without Supabase: dry runs read these CSVs
# ML_CSV_DIR=tests/fixtures
